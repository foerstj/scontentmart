[t:template,n:base_scm_merchant_loa_spell_nm]
{
	specializes = base_scm_merchant_loa_misc;
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "nature_spell_sparkle" );
				condition* = receive_world_message("we_entered_world");
			}
		}
	}
}
[t:template,n:base_scm_merchant_loa_spell_cm]
