[t:template,n:scm_merchant_armor_helm_fighter_normal]
{
	specializes = base_scm_merchant_adwana;

	common:screen_name = "Fighter Helmets";

	[inventory]
	{
		[store_pcontent]
		{
			full_ratio = 0;
			[armor]
